# ─────────────────────────────────────────────────────────────────────────────
# CSAgent Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=CSAgent
APP_ENV=development                  # development | production | test
DEBUG=true
API_V1_PREFIX=/luka-aegis/api/v1
LOG_DIR=logs
LOG_FILE=app.log

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — zero setup for local dev)
DATABASE_URL=sqlite+aiosqlite:///./csagent.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ── Gemini LLM ────────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key

# ── Qdrant (Vector DB) ────────────────────────────────────────────────────────
# Local Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
# Qdrant Cloud only — leave blank for local
QDRANT_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker: docker run -p 6379:6379 redis:alpine
REDIS_URL=redis://localhost:6379/0
