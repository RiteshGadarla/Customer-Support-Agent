# ─────────────────────────────────────────────────────────────────────────────
# CSAgent Frontend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────
# NOTE: All Vite env vars MUST be prefixed with VITE_ to be exposed to the browser.

# ── API ───────────────────────────────────────────────────────────────────────
# Local development
VITE_API_BASE_URL=http://localhost:8000/luka-aegis/api/v1

# Production — replace with your deployed backend URL
# VITE_API_BASE_URL=https://api.your-domain.com/luka-aegis/api/v1

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME=CSAgent
VITE_APP_ENV=development             # development | production
